# ==============================================================================
# ChurnLens Environment Configuration
# Copy this file to .env for local development overrides
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=ChurnLens ML Intelligence Platform
API_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration
# Default: Local SQLite database. For PostgreSQL production: postgresql://user:password@localhost:5432/churnlens
DATABASE_URL=sqlite:///./churnlens.db

# Machine Learning & Model Registry
MODEL_REGISTRY_DIR=models/production
ACTIVE_MODEL_VERSION=v1.0.0
DATA_RAW_PATH=data/raw/Telco_customer_churn.csv
DATA_PROCESSED_DIR=data/processed

# Classification Threshold
DEFAULT_DECISION_THRESHOLD=0.35
